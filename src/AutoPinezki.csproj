<Project Sdk="Microsoft.NET.Sdk">
  <!-- Put your own paths in src/Local.props (not in the repo), see src/Local.props.example -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AutoPinezki</AssemblyName>
    <Version>1.3.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</ProfileDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(ProfileDir)/BepInEx/plugins/Unknown-AutoPinezki</PluginDir>
    <Managed>$(ValheimDir)/valheim_Data/Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(Managed)/assembly_valheim.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_utils.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_guiutils.dll" Private="false" />
    <Reference Include="$(Managed)/Splatform.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(ProfileDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ProfileDir)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- If the mod is already imported into r2modman, replace the DLL right away. -->
  <Target Name="CopyToProfile" AfterTargets="Build" Condition="Exists('$(PluginDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
  </Target>

  <!-- Thunderstore/r2modman package: dist/AutoPinezki-<version>.zip -->
  <Target Name="ZipForR2modman" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup><StageDir>$(IntermediateOutputPath)package/</StageDir></PropertyGroup>
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath);../package/manifest.json;../package/README.md;../package/CHANGELOG.md;../package/icon.png" DestinationFolder="$(StageDir)" />
    <MakeDir Directories="../dist" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="../dist/AutoPinezki-$(Version).zip" Overwrite="true" />
  </Target>
</Project>
